APP_NAME=SchulBot
APP_ENV=production
APP_KEY=                          # php artisan key:generate --show
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# SQLite file lives in the web-data Docker volume
DB_DATABASE=/var/www/html/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

# Disable mail (Laravel internal)
MAIL_MAILER=log

# SchulBot internal secret – must match BOT_API_SECRET in .env.bot
BOT_API_SECRET=change-me-to-a-long-random-string