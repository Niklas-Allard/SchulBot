# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=info          # debug | info | warn | error

# ── IMAP (Gmail als Relay, Port 993 SSL) ─────────────────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURITY=SSL
IMAP_USERNAME=dein.bot@gmail.com
IMAP_PASSWORD=xxxx-xxxx-xxxx-xxxx   # Gmail App-Passwort (nicht das normale Passwort)
IMAP_MAILBOX=INBOX

# ── SMTP (IServ, Port 465 SSL) ────────────────────────────────────────────────
# IServ erlaubt internes Senden (@pggv.de → @pggv.de) – Antworten gehen zurück in IServ
SMTP_HOST=pggv.de
SMTP_PORT=465
SMTP_SECURITY=SSL
SMTP_USERNAME=dein.account          # nur der Account-Name, ohne @pggv.de
SMTP_PASSWORD=dein-iserv-passwort
SMTP_FROM_NAME=SchulBot
SMTP_FROM_ADDRESS=dein.account@pggv.de

# ── AI Provider ───────────────────────────────────────────────────────────────
# Unterstützt: gemini | cloudflare
AI_PROVIDER=cloudflare

# Cloudflare Workers AI
# API-URL: https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/run
AI_API_URL=https://api.cloudflare.com/client/v4/accounts/DEINE_ACCOUNT_ID/ai/run
AI_API_KEY=dein-cloudflare-api-token
AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# Google Gemini (alternativ)
# AI_PROVIDER=gemini
# AI_API_URL=https://generativelanguage.googleapis.com/v1beta
# AI_API_KEY=AIza...
# AI_MODEL=gemini-1.5-flash

# ── Sudoku ────────────────────────────────────────────────────────────────────
# API-Key von https://youdosudoku.com/
SUDOKU_API_KEY=dein-youdosudoku-api-key

# ── LibreTranslate (für /translate) ──────────────────────────────────────────
# Oeffentliche Instanzen (teils kein Key noetig):
#   https://libretranslate.com
#   https://translate.argosopentech.com
# Selbst hosten: https://github.com/LibreTranslate/LibreTranslate
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=   # leer lassen wenn Instanz keinen Key braucht

# ── Google (für #tasks und #calendar) ────────────────────────────────────────
# OAuth2 Refresh-Token einmalig über Google OAuth Playground holen.
# Scopes: https://www.googleapis.com/auth/tasks https://www.googleapis.com/auth/calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_TASKLIST_ID=    # leer = @default
GOOGLE_CALENDAR_ID=    # leer = primary

# ── Runtime ───────────────────────────────────────────────────────────────────
POLL_INTERVAL=30s
MAX_PAYLOAD_CHARS=4000
MAX_RESPONSE_CHARS=8000
DB_PATH=data/processed.db
