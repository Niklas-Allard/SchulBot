APP_ENV=production
LOG_LEVEL=info

# Multi-user mode: point to the web container
LARAVEL_API_URL=http://web
BOT_API_SECRET=change-me-to-a-long-random-string   # must match .env.web

# Runtime limits (applied to all users)
POLL_INTERVAL=30s
MAX_PAYLOAD_CHARS=4000
MAX_RESPONSE_CHARS=8000

DB_PATH=/app/data/processed.db

# Optional global integrations (apply to all users unless overridden per-user)
SUDOKU_API_KEY=
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Google Tasks/Calendar OAuth (global, applies when user config has no override)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_TASKLIST_ID=
GOOGLE_CALENDAR_ID=